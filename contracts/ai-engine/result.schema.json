{
  "$defs": {
    "Analysis": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Analysis Id",
          "type": "string"
        },
        "transaction_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Transaction Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "processing",
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "draft_response": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Draft Response"
        },
        "merchant_approval_required": {
          "const": true,
          "title": "Merchant Approval Required",
          "type": "boolean"
        }
      },
      "required": [
        "analysis_id",
        "transaction_id",
        "status",
        "findings",
        "draft_response",
        "merchant_approval_required"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "DocumentMatch": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "matched",
            "unmatched",
            "ambiguous",
            "unreadable",
            "duplicate"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "status",
        "reason"
      ],
      "title": "DocumentMatch",
      "type": "object"
    },
    "DraftClaim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "fact_ids"
      ],
      "title": "DraftClaim",
      "type": "object"
    },
    "ExtractedFact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "enum": [
            "transaction_id",
            "amount",
            "currency",
            "invoice_date",
            "order_date",
            "delivery_date",
            "delivery_status",
            "tracking_id"
          ],
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        }
      },
      "required": [
        "id",
        "name",
        "value",
        "source"
      ],
      "title": "ExtractedFact",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "issue_type": {
          "title": "Issue Type",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "recommendation": {
          "title": "Recommendation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "issue_type",
        "severity",
        "explanation",
        "source_ids",
        "recommendation"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ParsedPage": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "text": {
          "maxLength": 200000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "page",
        "text"
      ],
      "title": "ParsedPage",
      "type": "object"
    },
    "ProcessingIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ProcessingIssue",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "page",
        "start",
        "end",
        "quote"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "analysis": {
      "$ref": "#/$defs/Analysis"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/ParsedPage"
      },
      "title": "Pages",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/ExtractedFact"
      },
      "title": "Facts",
      "type": "array"
    },
    "matches": {
      "items": {
        "$ref": "#/$defs/DocumentMatch"
      },
      "title": "Matches",
      "type": "array"
    },
    "finding_sources": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/SourceReference"
        },
        "type": "array"
      },
      "title": "Finding Sources",
      "type": "object"
    },
    "draft_claims": {
      "items": {
        "$ref": "#/$defs/DraftClaim"
      },
      "title": "Draft Claims",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ProcessingIssue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "analysis",
    "pages",
    "facts",
    "matches",
    "finding_sources",
    "draft_claims",
    "issues"
  ],
  "title": "PipelineResult",
  "type": "object"
}
