# Documentation only. Export variables in your shell; the backend does not load this file.
APP_ENV=development
# Leave DATABASE_URL unset for temporary local demo mode.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/proofpay
STORAGE_ROOT=/ABSOLUTE/PRIVATE/PERSISTENT/DIRECTORY
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
OCR_ENABLED=false
# Optional Sandbox reporting: backend only; never NEXT_PUBLIC_ prefixed.
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_SECRET
PAYPAL_MERCHANT_ID=YOUR_LOCAL_PROOFPAY_MERCHANT_UUID
# Internal Streamlit demo UI only
BACKEND_URL=http://127.0.0.1:8000
